{
  "name": "minigol-club",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "MiniGol Club — futbolparaninos.club. Sitio de contenido SEO sobre fútbol infantil para padres con hijos de 4-12 años.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint . --ext .ts,.tsx,.astro",
    "format": "prettier --write \"**/*.{ts,tsx,astro,md,mdx,css,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro,md,mdx,css,json}\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^6.1.9",
    "astro-icon": "^1.1.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
