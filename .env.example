# Cloudflare Pages / Astro env vars
# Copia este archivo a .env y rellena los valores en cada entorno.

# Google Analytics 4
PUBLIC_GA_ID=

# Google AdSense (publisher ID, ej. ca-pub-XXXXXXXXXXXXXXXX)
PUBLIC_ADSENSE_CLIENT=

# Amazon Afiliados (tracking tag, ej. minigolclub-21)
PUBLIC_AMAZON_TAG=

# Search Console verification meta (opcional, también vale verificación DNS)
PUBLIC_GSC_VERIFICATION=
