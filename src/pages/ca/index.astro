---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE, SITE_URL } from '@/consts';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import PitchLines from '@/components/ui/PitchLines.astro';
import Chrono from '@/components/ui/Chrono.astro';
import { useTranslations, type Locale } from '@/i18n';

type ArticuloCa = CollectionEntry<'articulos-ca'>;

const locale: Locale = 'ca';
const t = useTranslations(locale);

const articulosCa: ArticuloCa[] = await getCollection(
  'articulos-ca',
  ({ data }: ArticuloCa) => !data.draft,
);
const articulos = articulosCa.sort(
  (a: ArticuloCa, b: ArticuloCa) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const monthName = new Date().toLocaleDateString('ca-ES', {
  month: 'long',
  year: 'numeric',
});

const articleHref = (article: ArticuloCa) => {
  const slug = (article.id.split('/').pop() ?? article.id).replace(/\.mdx?$/, '');
  return `/ca/${article.data.categoria}/${slug}/`;
};

const homeUrl = new URL('/ca/', SITE_URL).toString();
const homeEsUrl = new URL('/', SITE_URL).toString();
const hreflangs = [
  { lang: 'es', href: homeEsUrl },
  { lang: 'ca', href: homeUrl },
  { lang: 'x-default', href: homeEsUrl },
];
---

<BaseLayout
  title={SITE.name}
  description="MiniGol Club en català — futbol per a nens explicat per a pares. Estem traduint els nostres millors continguts."
  canonical={homeUrl}
  hreflangs={hreflangs}
>
  <Header hreflangs={hreflangs} />

  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden" style="border-bottom: 1px solid var(--color-border);">
    <div
      class="pointer-events-none absolute inset-0"
      style="color: var(--color-foreground);"
      aria-hidden="true"
    >
      <PitchLines opacity={0.13} class="h-full w-full" />
    </div>

    <div class="relative mx-auto max-w-7xl px-5 py-9 md:px-12 md:py-18">
      <div class="mb-4 flex flex-wrap items-center gap-3 md:mb-5">
        <span class="stamp">{t('home-edition')} · {monthName.toUpperCase()}</span>
        <span
          class="hand inline-block"
          style="font-size: 22px; color: var(--color-handwritten); transform: rotate(-4deg);"
        >
          {t('home-welcome')}
        </span>
      </div>

      <h1
        class="display m-0"
        style="font-size: clamp(2.75rem, 6vw, 4.75rem); line-height: 0.95; letter-spacing: -0.025em;"
      >
        {t('home-h1-line1')}<br />
        <span class="marker">{t('home-h1-line2')}</span>
      </h1>

      <p
        class="mt-5 text-base leading-relaxed md:text-lg"
        style="color: var(--color-foreground-muted); max-width: 640px;"
      >
        {t('home-lead-ca')}
      </p>

      <div class="mt-5 flex flex-wrap gap-2.5">
        <a href="/" class="btn btn-ghost">
          {t('home-cta-switch-es')}
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="divider-pitch"></div>
  </section>

  <main id="main">
    <!-- ============ Artículos en catalán ============ -->
    <section class="mx-auto max-w-7xl px-4 pb-4 pt-9 md:px-12 md:pt-16">
      <div class="mb-8">
        <p
          class="mono text-xs font-medium uppercase"
          style="letter-spacing: 0.12em; color: var(--color-foreground-subtle);"
        >
          {t('home-articles-subtitle-ca')}
        </p>
        <h2
          class="display mt-2 m-0"
          style="font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.05; letter-spacing: -0.02em;"
        >
          {t('home-articles-title-ca')}
        </h2>
      </div>

      <div class="grid gap-3.5 md:grid-cols-3 md:gap-5">
        {articulos.map((article: ArticuloCa) => (
          <a
            href={articleHref(article)}
            class="card-paper flex flex-col overflow-hidden"
          >
            <Image
              src={article.data.cover}
              alt={article.data.coverAlt}
              widths={[320, 480, 640, 800, 1200]}
              sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
              class="block w-full"
              style="aspect-ratio: 16/10; object-fit: cover; border-bottom: 1px solid var(--color-border);"
            />
            <div class="flex flex-1 flex-col gap-3 p-4 md:p-5">
              <h3
                class="display m-0 text-lg md:text-xl"
                style="line-height: 1.15; font-weight: 700; color: var(--color-foreground);"
              >
                {article.data.title}
              </h3>
              {article.data.tiempoLectura && (
                <div class="mt-auto flex items-center gap-3">
                  <Chrono minutes={article.data.tiempoLectura} />
                  <span
                    class="mono"
                    style="font-size: 11px; color: var(--color-foreground-subtle); letter-spacing: 0.04em;"
                  >
                    {article.data.edadMin}–{article.data.edadMax} anys
                  </span>
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ============ Què vindrà aviat ============ -->
    <section class="mx-auto max-w-7xl px-4 pb-16 pt-12 md:px-12 md:pb-20 md:pt-16">
      <div
        class="card-paper mx-auto max-w-2xl p-6 text-center md:p-10"
      >
        <h2
          class="display m-0 text-2xl md:text-3xl"
          style="line-height: 1.1; font-weight: 700;"
        >
          {t('home-coming-title')}
        </h2>
        <p
          class="mt-4 text-base leading-relaxed"
          style="color: var(--color-foreground-muted);"
        >
          {t('home-coming-text')}
        </p>
        <a href="/contacto/" class="btn btn-primary mt-6 inline-flex">
          {t('footer-contact')}
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
