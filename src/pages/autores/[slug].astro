---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { personJsonLd } from '@/lib/seo';
import { SITE_URL } from '@/consts';

export async function getStaticPaths() {
  const autores: CollectionEntry<'autores'>[] = await getCollection('autores');
  return autores.map((autor: CollectionEntry<'autores'>) => ({
    params: { slug: autor.data.slug },
    props: { autor },
  }));
}

interface Props {
  autor: CollectionEntry<'autores'>;
}

const { autor } = Astro.props;
const {
  nombre,
  slug,
  bio,
  titulacion,
  experiencia,
  twitter,
  instagram,
} = autor.data;

// Artículos publicados escritos por este autor
type ArticuloEntry = CollectionEntry<'articulos'>;
const todosArticulos: ArticuloEntry[] = await getCollection('articulos');
const articulosAutor = todosArticulos
  .filter((a: ArticuloEntry) => !a.data.draft && a.data.autor === slug)
  .sort((a: ArticuloEntry, b: ArticuloEntry) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// URL canónica y de imagen
const canonicalUrl = `${SITE_URL}/autores/${slug}/`;
// Imagen absoluta para JSON-LD (puede no existir como asset real, pero la referenciamos)
const avatarAbsoluteUrl = `${SITE_URL}/autores/${slug}.jpg`;

// Redes sociales → sameAs para Person schema
const sameAs: string[] = [];
if (twitter) sameAs.push(`https://twitter.com/${twitter.replace('@', '')}`);
if (instagram) sameAs.push(`https://instagram.com/${instagram.replace('@', '')}`);

const jsonLd = personJsonLd({
  name: nombre,
  url: canonicalUrl,
  image: avatarAbsoluteUrl,
  sameAs,
  jobTitle: titulacion,
  description: bio,
});

// Iniciales para el avatar de fallback
const iniciales = nombre
  .split(' ')
  .map((p: string) => p[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();

const metaDescription = `${bio.slice(0, 140)}${bio.length > 140 ? '...' : ''}`;
---

<BaseLayout
  title={`Sobre ${nombre}`}
  description={metaDescription}
  canonical={canonicalUrl}
  ogType="website"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <Header />

  <div class="mx-auto max-w-4xl px-4 md:px-6">
    <Breadcrumb
      items={[
        { label: 'Autores', href: '/autores/' },
        { label: nombre },
      ]}
    />
  </div>

  <main id="main" class="mx-auto max-w-4xl px-4 pb-16 md:px-6">

    <!-- ===== Hero del autor ===== -->
    <section
      class="card-paper mb-10 flex flex-col items-center gap-6 p-6 text-center sm:flex-row sm:text-left md:gap-8 md:p-8"
      aria-label={`Perfil de ${nombre}`}
    >
      <!-- Avatar: fallback con iniciales sobre color de marca -->
      <div
        class="grid h-24 w-24 shrink-0 place-items-center overflow-hidden rounded-full text-3xl font-bold"
        style="background: var(--color-primary); color: var(--color-on-brand); border: 3px solid var(--color-border-strong);"
        aria-hidden="true"
      >
        {iniciales}
      </div>

      <div class="flex-1">
        <!-- Dorsal decorativo de fondo -->
        <div class="relative inline-block">
          <span
            class="dorsal-fill pointer-events-none absolute select-none"
            style="top: -20px; right: -10px; font-size: 80px; color: var(--color-primary); opacity: 0.08; line-height: 0.85; z-index: 0;"
            aria-hidden="true"
          >
            10
          </span>
          <h1
            class="display relative m-0"
            style="font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1; letter-spacing: -0.02em; z-index: 1;"
          >
            {nombre}
          </h1>
        </div>

        {titulacion && (
          <p
            class="mt-1.5 text-base font-semibold"
            style="color: var(--color-primary);"
          >
            {titulacion}
          </p>
        )}

        <!-- Badges de experiencia -->
        {experiencia && (
          <div class="mt-3 flex flex-wrap justify-center gap-2 sm:justify-start">
            <span
              class="mono inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold"
              style="background: var(--color-surface-alt); color: var(--color-foreground-muted); border: 1px solid var(--color-border);"
            >
              {experiencia}
            </span>
          </div>
        )}
      </div>
    </section>

    <!-- ===== Bio extendida ===== -->
    <section
      class="mb-10"
      aria-labelledby="bio-heading"
    >
      <h2
        id="bio-heading"
        class="display mb-4"
        style="font-size: 1.25rem; font-weight: 700;"
      >
        Sobre mí
      </h2>
      <div
        class="card-paper p-5 md:p-6"
      >
        <!-- Marca de resaltado manuscrita en la primera línea -->
        <p
          class="m-0 text-base leading-relaxed"
          style="color: var(--color-foreground-muted);"
        >
          {bio}
        </p>
      </div>
    </section>

    <!-- ===== Credenciales ===== -->
    {(titulacion || experiencia) && (
      <section
        class="mb-10"
        aria-labelledby="credenciales-heading"
      >
        <h2
          id="credenciales-heading"
          class="display mb-4"
          style="font-size: 1.25rem; font-weight: 700;"
        >
          Credenciales
        </h2>
        <div
          class="card-paper divide-y p-0"
          style="--tw-divide-opacity: 1; border-color: var(--color-border);"
        >
          {titulacion && (
            <div class="flex items-start gap-4 p-5">
              <!-- Icono de diploma/badge -->
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                style="color: var(--color-primary); flex-shrink: 0; margin-top: 2px;"
              >
                <circle cx="12" cy="8" r="6"></circle>
                <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"></path>
              </svg>
              <div>
                <div
                  class="mono mb-0.5 text-xs font-semibold tracking-widest"
                  style="color: var(--color-foreground-subtle);"
                >
                  TITULACIÓN
                </div>
                <div style="font-weight: 600;">{titulacion}</div>
              </div>
            </div>
          )}
          {experiencia && (
            <div class="flex items-start gap-4 p-5">
              <!-- Icono de reloj/calendario -->
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                style="color: var(--color-primary); flex-shrink: 0; margin-top: 2px;"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <div>
                <div
                  class="mono mb-0.5 text-xs font-semibold tracking-widest"
                  style="color: var(--color-foreground-subtle);"
                >
                  EXPERIENCIA
                </div>
                <div style="font-weight: 600;">{experiencia}</div>
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ===== Redes sociales ===== -->
    {(twitter || instagram) && (
      <section
        class="mb-10"
        aria-labelledby="redes-heading"
      >
        <h2
          id="redes-heading"
          class="display mb-4"
          style="font-size: 1.25rem; font-weight: 700;"
        >
          Sigue a este autor
        </h2>
        <div class="flex flex-wrap gap-3">
          {twitter && (
            <a
              href={`https://twitter.com/${twitter.replace('@', '')}`}
              rel="noopener noreferrer me"
              target="_blank"
              class="inline-flex items-center gap-2.5 rounded-button px-5 py-3 font-semibold transition-opacity hover:opacity-80"
              style="background: var(--color-surface-alt); border: 1px solid var(--color-border); color: var(--color-foreground); min-height: 44px;"
            >
              <!-- X/Twitter icon -->
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
              </svg>
              <span>@{twitter.replace('@', '')}</span>
            </a>
          )}
          {instagram && (
            <a
              href={`https://instagram.com/${instagram.replace('@', '')}`}
              rel="noopener noreferrer me"
              target="_blank"
              class="inline-flex items-center gap-2.5 rounded-button px-5 py-3 font-semibold transition-opacity hover:opacity-80"
              style="background: var(--color-surface-alt); border: 1px solid var(--color-border); color: var(--color-foreground); min-height: 44px;"
            >
              <!-- Instagram icon -->
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
              </svg>
              <span>@{instagram.replace('@', '')}</span>
            </a>
          )}
        </div>
      </section>
    )}

    <!-- ===== Artículos por este autor ===== -->
    <section aria-labelledby="articulos-heading">
      <div class="mb-5 flex items-baseline justify-between gap-4">
        <h2
          id="articulos-heading"
          class="display m-0"
          style="font-size: 1.25rem; font-weight: 700;"
        >
          Artículos de {nombre}
        </h2>
        <span
          class="mono text-xs"
          style="color: var(--color-foreground-subtle);"
        >
          {articulosAutor.length} {articulosAutor.length === 1 ? 'artículo' : 'artículos'}
        </span>
      </div>

      {articulosAutor.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {articulosAutor.map((articulo: ArticuloEntry) => (
            <ArticleCard article={articulo} />
          ))}
        </div>
      ) : (
        <div
          class="card-paper flex items-center justify-center p-10 text-center"
        >
          <p
            class="hand text-lg"
            style="color: var(--color-foreground-muted);"
          >
            Próximamente más artículos…
          </p>
        </div>
      )}
    </section>

  </main>

  <Footer />
</BaseLayout>
