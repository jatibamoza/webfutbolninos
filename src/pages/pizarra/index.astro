---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SmokeTest from '@/components/pizarra/SmokeTest';

// Placeholder de la futura landing /pizarra/ — sustituida en Fase 2 (Pizarra MVP).
// Mantenido fuera de indexación hasta que la herramienta real esté lista.
---

<BaseLayout
  title="Pizarra (en construcción)"
  description="Página en construcción. La herramienta de pizarra táctica estará disponible próximamente."
  noindex={true}
>
  <Header />
  <main id="main" class="mx-auto max-w-3xl px-4 py-12 md:px-6">
    <h1 class="display" style="font-size: 32px; font-weight: 700; margin-bottom: 16px;">
      Pizarra táctica · en construcción
    </h1>
    <p style="color: var(--color-foreground-muted); margin-bottom: 24px;">
      Esta página será reemplazada por la herramienta interactiva en la Fase 2 del producto.
      Mientras tanto, sirve como verificación de la integración de Preact.
    </p>
    <SmokeTest client:only="preact" />
  </main>
  <Footer />
</BaseLayout>
