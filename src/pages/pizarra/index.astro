---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Board } from '@/components/pizarra/Board';

// F2.6 — Board montado. Noindex hasta que la landing real esté lista (F2.13).
---

<BaseLayout
  title="Pizarra táctica (beta)"
  description="Herramienta interactiva en pruebas. La landing definitiva estará disponible próximamente."
  noindex={true}
>
  <Header />
  <main id="main" style="height: calc(100vh - 128px); display: flex; flex-direction: column;">
    <Board preset="rondo-4v1" client:only="preact" />
  </main>
  <Footer />
</BaseLayout>
