---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/consts';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import PitchLines from '@/components/ui/PitchLines.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import NotebookHero from '@/components/ui/NotebookHero.astro';
import NewsletterInline from '@/components/ui/NewsletterInline.astro';
import CatChip from '@/components/ui/CatChip.astro';
import Chrono from '@/components/ui/Chrono.astro';
import { categoryColorVar, categoryHref } from '@/lib/categories';

type ArticuloEntry = CollectionEntry<'articulos'>;
type CategoriaEntry = CollectionEntry<'categorias'>;

// Categorías ordenadas para el bento.
const allCategorias: CategoriaEntry[] = await getCollection('categorias');
const categorias = allCategorias.sort(
  (a: CategoriaEntry, b: CategoriaEntry) => a.data.orden - b.data.orden,
);

// Conteo de artículos publicados por categoría (sin drafts).
const allArticulos: ArticuloEntry[] = await getCollection('articulos');
const articulosPub = allArticulos.filter((a: ArticuloEntry) => !a.data.draft);
const countByCat: Record<string, number> = {};
for (const art of articulosPub) {
  countByCat[art.data.categoria] = (countByCat[art.data.categoria] ?? 0) + 1;
}

// "Lo más leído": como aún no tenemos GA4, mostramos los featured + recientes.
const featured = articulosPub
  .filter((a: ArticuloEntry) => a.data.featured)
  .sort((a: ArticuloEntry, b: ArticuloEntry) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// "Últimos artículos": los 3 más recientes que no estén ya en featured.
const featuredIds = new Set(featured.map((a: ArticuloEntry) => a.id));
const ultimos = articulosPub
  .filter((a: ArticuloEntry) => !featuredIds.has(a.id))
  .sort((a: ArticuloEntry, b: ArticuloEntry) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Mes/edición visible en el sello del hero.
const monthName = new Date().toLocaleDateString('es-ES', {
  month: 'long',
  year: 'numeric',
});

const articleHref = (article: CollectionEntry<'articulos'>) =>
  `/${article.id.replace(/\.mdx?$/, '')}/`;

// Iconos lucide por slug — en algunos casos el JSON los nombra distinto.
const ICON_BY_SLUG: Record<string, string> = {
  ejercicios: 'lucide:dumbbell',
  juegos: 'lucide:gamepad-2',
  equipamiento: 'lucide:shopping-bag',
  iniciacion: 'lucide:flag',
  recursos: 'lucide:download',
  'mundial-2026': 'lucide:trophy',
};
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <Header />

  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden" style="border-bottom: 1px solid var(--color-border);">
    <!-- Líneas de campo decorativas -->
    <div
      class="pointer-events-none absolute inset-0"
      style="color: var(--color-foreground);"
      aria-hidden="true"
    >
      <PitchLines opacity={0.13} class="h-full w-full" />
    </div>

    <div
      class="relative mx-auto grid max-w-7xl items-center gap-7 px-5 py-9 md:gap-12 md:px-12 md:py-18 lg:grid-cols-[1.2fr_1fr]"
    >
      <!-- Texto -->
      <div>
        <div class="mb-4 flex flex-wrap items-center gap-3 md:mb-5">
          <span class="stamp">EDICIÓN · {monthName.toUpperCase()}</span>
          <span
            class="hand inline-block"
            style="font-size: 22px; color: var(--color-handwritten); transform: rotate(-4deg);"
          >
            ¡bienvenido!
          </span>
        </div>

        <h1
          class="display m-0"
          style="font-size: clamp(2.75rem, 6vw, 4.75rem); line-height: 0.95; letter-spacing: -0.025em;"
        >
          Fútbol para niños,<br />
          <span class="marker">explicado</span> para padres.
        </h1>

        <p
          class="mt-5 text-base leading-relaxed md:text-lg"
          style="color: var(--color-foreground-muted); max-width: 540px;"
        >
          Ejercicios, juegos y guías sin tecnicismos. Para que entrenes con tu peque
          en el parque sin sentirte un mal entrenador.
        </p>

        <!-- Selector de edad opcional -->
        <div
          class="mt-6 max-w-md rounded-xl p-3.5"
          style="border: 1.5px solid var(--color-border); background: var(--color-paper);"
        >
          <div class="mb-2 flex items-center justify-between">
            <span class="hand" style="font-size: 18px; color: var(--color-handwritten);">
              ¿qué edad tiene tu peque?
            </span>
            <span class="mono" style="font-size: 10px; color: var(--color-foreground-subtle);">
              OPCIONAL
            </span>
          </div>
          <div class="flex flex-wrap gap-1.5" data-age-group>
            {['4-6', '7-8', '9-10', '11-12'].map((a) => (
              <button
                type="button"
                data-age-chip={a}
                class="rounded-full px-3.5 text-sm font-bold transition-all"
                style="min-height: 44px; padding: 10px 14px; border: 1.5px solid var(--color-border-strong); background: transparent; color: var(--color-foreground);"
              >
                {a} años
              </button>
            ))}
          </div>
        </div>

        <div class="mt-5 flex flex-wrap gap-2.5">
          <a href="/ejercicios/" class="btn btn-primary">
            Explorar ejercicios
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
          <a href="#lo-mas-leido" class="btn btn-ghost">
            Ver lo más leído
          </a>
        </div>
      </div>

      <!-- Cuaderno hero -->
      <div class="hidden lg:block">
        <NotebookHero />
      </div>
    </div>

    <div class="divider-pitch"></div>
  </section>

  <main id="main">

    <!-- ============ Categorías (bento) ============ -->
    <section class="mx-auto max-w-7xl px-4 pb-3 pt-9 md:px-12 md:pb-6 md:pt-16">
      <SectionHeader
        number="01"
        hand="el equipo"
        title="Categorías"
        subtitle="Seis vestuarios. Elige el tuyo."
      />

      <div
        class="mt-6 grid gap-2.5 md:gap-4"
        style="grid-template-columns: repeat(2, minmax(0,1fr));"
        data-bento
      >
        {categorias.map((cat: CategoriaEntry, i: number) => {
          const color = categoryColorVar(cat.data.color);
          const count = countByCat[cat.data.slug] ?? 0;
          const iconName = ICON_BY_SLUG[cat.data.slug] ?? 'lucide:flag';
          return (
            <a
              href={categoryHref(cat.data.slug)}
              class="card-paper relative flex flex-col justify-between overflow-hidden p-4 md:p-6"
              style="min-height: 130px;"
            >
              <div class="flex items-start justify-between">
                <span
                  class="grid h-9 w-9 place-items-center rounded-md"
                  style={`background: ${color}; color: var(--color-on-brand);`}
                  aria-hidden="true"
                >
                  <Icon name={iconName} class="h-4.5 w-4.5" />
                </span>
                <span
                  class="mono"
                  style="font-size: 10px; letter-spacing: 0.1em; color: var(--color-foreground-subtle);"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <div>
                <div class="display mt-3 text-xl md:text-2xl" style="line-height: 1.05; font-weight: 700;">
                  {cat.data.nombre}
                </div>
                <div
                  class="mono mt-1.5"
                  style="font-size: 10px; letter-spacing: 0.05em; color: var(--color-foreground-muted);"
                >
                  {count} {count === 1 ? 'artículo' : 'artículos'}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- ============ Lo más leído ============ -->
    {featured.length > 0 && (
      <section id="lo-mas-leido" class="mx-auto max-w-7xl px-4 pb-4 pt-8 md:px-12 md:pb-4 md:pt-14">
        <SectionHeader
          number="02"
          hand="el partido"
          title="Lo más leído"
          subtitle="Lo que otros padres están leyendo esta semana."
        />
        <div class="mt-6 grid gap-3.5 md:grid-cols-3 md:gap-5">
          {featured.map((article: ArticuloEntry) => (
            <a
              href={articleHref(article)}
              class="card-paper flex flex-col overflow-hidden"
            >
              <img
                src={article.data.cover}
                alt={article.data.coverAlt}
                width={article.data.coverWidth}
                height={article.data.coverHeight}
                loading="lazy"
                decoding="async"
                class="block w-full"
                style="aspect-ratio: 16/10; object-fit: cover; border-bottom: 1px solid var(--color-border);"
              />
              <div class="flex flex-1 flex-col gap-3 p-4 md:p-5">
                <CatChip category={article.data.categoria} variant="bar" />
                <h3
                  class="display m-0 text-lg md:text-xl"
                  style="line-height: 1.15; font-weight: 700; color: var(--color-foreground);"
                >
                  {article.data.title}
                </h3>
                {article.data.tiempoLectura && (
                  <div class="mt-auto flex items-center gap-3">
                    <Chrono minutes={article.data.tiempoLectura} />
                    <span
                      class="mono"
                      style="font-size: 11px; color: var(--color-foreground-subtle); letter-spacing: 0.04em;"
                    >
                      {article.data.edadMin}–{article.data.edadMax} años
                    </span>
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ============ Últimos artículos ============ -->
    {ultimos.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 pb-4 pt-8 md:px-12 md:pt-14">
        <SectionHeader
          number="03"
          hand="cantera"
          title="Últimos artículos"
          subtitle="Lo que acabamos de publicar."
        />
        <div class="mt-6 grid gap-3.5 md:grid-cols-3 md:gap-5">
          {ultimos.map((article: ArticuloEntry) => (
            <a
              href={articleHref(article)}
              class="card-paper flex flex-col overflow-hidden"
            >
              <img
                src={article.data.cover}
                alt={article.data.coverAlt}
                width={article.data.coverWidth}
                height={article.data.coverHeight}
                loading="lazy"
                decoding="async"
                class="block w-full"
                style="aspect-ratio: 16/10; object-fit: cover; border-bottom: 1px solid var(--color-border);"
              />
              <div class="flex flex-1 flex-col gap-3 p-4 md:p-5">
                <CatChip category={article.data.categoria} variant="bar" />
                <h3
                  class="display m-0 text-lg md:text-xl"
                  style="line-height: 1.15; font-weight: 700; color: var(--color-foreground);"
                >
                  {article.data.title}
                </h3>
                {article.data.tiempoLectura && (
                  <div class="mt-auto flex items-center gap-3">
                    <Chrono minutes={article.data.tiempoLectura} />
                    <span
                      class="mono"
                      style="font-size: 11px; color: var(--color-foreground-subtle); letter-spacing: 0.04em;"
                    >
                      {article.data.edadMin}–{article.data.edadMax} años
                    </span>
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ============ Newsletter ============ -->
    <NewsletterInline />
  </main>

  <Footer />
</BaseLayout>

<!-- Bento de 3 columnas en desktop (Tailwind no aplica desde inline grid-template-columns) -->
<style>
  @media (min-width: 768px) {
    [data-bento] {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }
</style>

<script>
  // Selector de edad persistible en localStorage como `mg.age`.
  const STORAGE_KEY = 'mg.age';
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-age-chip]'));

  const applyActive = (value: string | null) => {
    for (const btn of buttons) {
      const active = btn.dataset.ageChip === value;
      btn.style.background = active ? 'var(--color-foreground)' : 'transparent';
      btn.style.color = active ? 'var(--color-background)' : 'var(--color-foreground)';
      btn.style.borderColor = active ? 'var(--color-foreground)' : 'var(--color-border-strong)';
      btn.setAttribute('aria-pressed', String(active));
    }
  };

  let stored: string | null = null;
  try {
    stored = localStorage.getItem(STORAGE_KEY);
  } catch {
    /* localStorage no disponible */
  }
  applyActive(stored);

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const value = btn.dataset.ageChip ?? null;
      const isAlreadyActive = btn.getAttribute('aria-pressed') === 'true';
      const next = isAlreadyActive ? null : value;
      try {
        if (next) localStorage.setItem(STORAGE_KEY, next);
        else localStorage.removeItem(STORAGE_KEY);
      } catch {
        /* sin persistencia, OK */
      }
      applyActive(next);
    });
  }
</script>
