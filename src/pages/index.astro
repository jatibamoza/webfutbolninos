---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/consts';
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <Header />
  <main id="main">
    <section class="mx-auto max-w-3xl px-6 py-20 text-center">
      <p class="mb-4 inline-block rounded-button bg-accent/15 px-3 py-1 text-sm font-semibold text-foreground-muted">
        Próximamente
      </p>
      <h1 class="font-display text-5xl font-bold leading-tight md:text-6xl">
        {SITE.name}
      </h1>
      <p class="mt-4 font-display text-xl text-primary md:text-2xl">
        {SITE.tagline}
      </p>
      <p class="mx-auto mt-8 max-w-2xl text-lg text-foreground-muted">
        {SITE.description}
      </p>
      <p class="mt-10 text-sm text-foreground-muted">
        Estamos preparando el sitio. Vuelve pronto.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
