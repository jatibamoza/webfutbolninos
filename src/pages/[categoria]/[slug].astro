---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articulos = await getCollection(
    'articulos',
    ({ data }: CollectionEntry<'articulos'>) => !data.draft
  );

  return articulos.map((article: CollectionEntry<'articulos'>) => ({
    params: {
      categoria: article.data.categoria,
      slug: (article.id.split('/').pop() ?? article.id).replace(/\.mdx?$/, ''),
    },
    props: { article },
  }));
}

const { article } = Astro.props as { article: CollectionEntry<'articulos'> };
const { Content, headings } = await render(article);

const categoria = await getEntry('categorias', article.data.categoria);

const allArticulos = await getCollection(
  'articulos',
  ({ data }: CollectionEntry<'articulos'>) => !data.draft
);
const relatedArticles = allArticulos
  .filter(
    (a: CollectionEntry<'articulos'>) =>
      a.id !== article.id &&
      (a.data.categoria === article.data.categoria ||
        a.data.tags.some((tag: string) => article.data.tags.includes(tag)))
  )
  .sort(
    (a: CollectionEntry<'articulos'>, b: CollectionEntry<'articulos'>) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  )
  .slice(0, 3);
---

<ArticleLayout
  article={article}
  categoriaNombre={categoria?.data.nombre ?? article.data.categoria}
  categoriaSlug={article.data.categoria}
  categoriaColor={categoria?.data.color ?? 'secondary'}
  relatedArticles={relatedArticles}
  headings={headings}
>
  <Content />
</ArticleLayout>
