---
import { getCollection, type CollectionEntry } from 'astro:content';
import CategoryLayout from '@/layouts/CategoryLayout.astro';

export async function getStaticPaths() {
  const categorias = await getCollection('categorias');
  const articulos = await getCollection(
    'articulos',
    ({ data }: CollectionEntry<'articulos'>) => !data.draft
  );

  return categorias.map((categoria: CollectionEntry<'categorias'>) => {
    const articulosCategoria = articulos
      .filter((a: CollectionEntry<'articulos'>) => a.data.categoria === categoria.data.slug)
      .sort(
        (a: CollectionEntry<'articulos'>, b: CollectionEntry<'articulos'>) =>
          b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
      );

    return {
      params: { categoria: categoria.data.slug },
      props: { categoria, articles: articulosCategoria },
    };
  });
}

const { categoria, articles } = Astro.props;
---

<CategoryLayout categoria={categoria} articles={articles} />
