---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import CatChip from '@/components/ui/CatChip.astro';
import Chrono from '@/components/ui/Chrono.astro';

interface Props {
  article: CollectionEntry<'articulos'>;
  categoriaColor?: string;
  categoriaNombre?: string;
  loading?: 'lazy' | 'eager';
  /** Si true, oculta el chip de categoría (cuando ya estamos dentro de la categoría). */
  hideCategoryChip?: boolean;
}

const {
  article,
  categoriaNombre,
  loading = 'lazy',
  hideCategoryChip = false,
} = Astro.props;

const {
  title,
  description,
  cover,
  coverAlt,
  pubDate,
  edadMin,
  edadMax,
  nivel,
  tiempoLectura,
  categoria,
} = article.data;

const slug = `/${article.id.replace(/\.mdx?$/, '')}/`;

const dateFormatted = pubDate.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article
  class="group h-full"
  data-article-card
  data-edad-min={edadMin}
  data-edad-max={edadMax}
  data-nivel={nivel}
>
  <a
    href={slug}
    class="card-paper flex h-full flex-col overflow-hidden"
  >
    <!-- Cover: <Image> sirve WebP/AVIF + responsive srcset segun viewport -->
    <div class="overflow-hidden" style={`aspect-ratio: 16/10; border-bottom: 1px solid var(--color-border);`}>
      <Image
        src={cover}
        alt={coverAlt}
        widths={[320, 480, 640, 800, 1200]}
        sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
        loading={loading}
        decoding="async"
        class="block h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
      />
    </div>

    <!-- Content -->
    <div class="flex flex-1 flex-col gap-3 p-4 md:p-5">
      {!hideCategoryChip && (
        <CatChip category={categoria} label={categoriaNombre} variant="bar" />
      )}

      <h3
        class="display m-0 line-clamp-2"
        style="font-size: 18px; line-height: 1.15; font-weight: 700; color: var(--color-foreground);"
      >
        {title}
      </h3>

      <p
        class="line-clamp-2 text-sm leading-relaxed"
        style="color: var(--color-foreground-muted);"
      >
        {description}
      </p>

      <div class="mt-auto flex items-center justify-between gap-3 pt-2">
        <div class="flex items-center gap-3">
          {tiempoLectura && <Chrono minutes={tiempoLectura} />}
          <span
            class="mono"
            style="font-size: 11px; letter-spacing: 0.04em; color: var(--color-foreground-subtle);"
          >
            {edadMin}–{edadMax} años
          </span>
        </div>
        <time
          datetime={pubDate.toISOString()}
          class="mono"
          style="font-size: 10px; letter-spacing: 0.04em; color: var(--color-foreground-subtle);"
        >
          {dateFormatted}
        </time>
      </div>
    </div>
  </a>
</article>
