---
interface Props {
  number: string | number;
  hand?: string;
  title: string;
  subtitle?: string;
  level?: 2 | 3;
}

const { number, hand, title, subtitle, level = 2 } = Astro.props;
const display = typeof number === 'number' ? String(number).padStart(2, '0') : number;
const Tag = `h${level}` as const;
---

<div
  class="flex flex-wrap items-end justify-between gap-3 pb-3"
  style="border-bottom: 2px solid var(--color-foreground);"
>
  <div>
    <div class="mb-1 flex items-baseline gap-3.5">
      <span class="dorsal-fill" style="font-size: 56px; opacity: 0.9;">{display}</span>
      {hand && (
        <span
          class="hand inline-block"
          style="font-size: 22px; color: var(--color-handwritten); transform: rotate(-3deg);"
        >
          {hand}
        </span>
      )}
    </div>
    <Tag class="display m-0" style="font-size: 30px; line-height: 1;">{title}</Tag>
  </div>
  {subtitle && (
    <p
      class="m-0 max-w-xs text-right text-sm"
      style="color: var(--color-foreground-muted);"
    >
      {subtitle}
    </p>
  )}
</div>
