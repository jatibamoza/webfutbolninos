---
interface Props {
  value: number | string;
  size?: number;
  variant?: 'outline' | 'fill';
  color?: string;
  opacity?: number;
  class?: string;
}

const {
  value,
  size = 120,
  variant = 'outline',
  color,
  opacity,
  class: className = '',
} = Astro.props;

const display = typeof value === 'number' ? String(value).padStart(2, '0') : value;
const baseClass = variant === 'outline' ? 'dorsal-outline' : 'dorsal-fill';
const style = [
  `font-size: ${size}px`,
  color ? `color: ${color}` : '',
  opacity !== undefined ? `opacity: ${opacity}` : '',
].filter(Boolean).join('; ');
---

<span class:list={[baseClass, className]} style={style} aria-hidden="true">{display}</span>
