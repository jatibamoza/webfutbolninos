---
interface Props {
  opacity?: number;
  class?: string;
}

const { opacity = 0.18, class: className = '' } = Astro.props;
---

<svg
  class:list={[className]}
  viewBox="0 0 800 400"
  preserveAspectRatio="none"
  style={`opacity: ${opacity};`}
  aria-hidden="true"
>
  <defs>
    <pattern id="pl-grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M40 0H0V40" fill="none" stroke="currentColor" stroke-width="0.5"></path>
    </pattern>
  </defs>
  <rect width="800" height="400" fill="url(#pl-grid)"></rect>
  <rect x="20" y="20" width="760" height="360" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
  <line x1="400" y1="20" x2="400" y2="380" stroke="currentColor" stroke-width="1.5"></line>
  <circle cx="400" cy="200" r="60" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
  <circle cx="400" cy="200" r="3" fill="currentColor"></circle>
  <rect x="20" y="120" width="100" height="160" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
  <rect x="680" y="120" width="100" height="160" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
  <rect x="20" y="160" width="40" height="80" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
  <rect x="740" y="160" width="40" height="80" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
</svg>
