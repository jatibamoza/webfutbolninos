---
interface Props {
  /**
   * Tamaño del logo en píxeles. Decide qué detalles incluye:
   * - 32: solo escudo + M (favicon)
   * - 64: + círculo central de las líneas de campo
   * - 128: + cinta CLUB con estrellas
   * - 240+: + EST·2026 abajo (logo completo)
   */
  size?: number;
  /** 'light' (escudo navy sobre crema) o 'dark' (escudo crema sobre navy) */
  theme?: 'light' | 'dark';
  /** Texto accesible. Si se omite, el SVG es decorativo. */
  title?: string;
  class?: string;
}

const {
  size = 240,
  theme = 'light',
  title,
  class: className = '',
} = Astro.props;

const showFieldLines = size >= 64;
const showClubBand = size >= 128;
const showEst = size >= 240;

// Paleta según tema. La M y las estrellas siempre son acento amarillo.
const shieldFill = theme === 'light' ? '#1A1F2C' : '#FFFCF1';
const inkFill = theme === 'light' ? '#FFFCF1' : '#1A1F2C';
const accentFill = '#F59E0B';
const fieldLinesOpacity = theme === 'light' ? 0.5 : 0.42;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={[className]}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title ?? undefined}
>
  {title && <title>{title}</title>}

  {/* Escudo */}
  <path
    d="M50 6 L88 16 L88 50 C88 74 72 88 50 94 C28 88 12 74 12 50 L12 16 Z"
    fill={shieldFill}
  ></path>

  {/* Líneas de campo */}
  {showFieldLines && (
    <g stroke={inkFill} stroke-width="1.2" fill="none" opacity={fieldLinesOpacity}>
      <rect x="22" y="20" width="56" height="48" rx="3"></rect>
      <line x1="50" y1="20" x2="50" y2="68"></line>
      <circle cx="50" cy="44" r="9"></circle>
    </g>
  )}

  {/* M monograma */}
  <text
    x="50"
    y="57"
    text-anchor="middle"
    font-family="'Fredoka', system-ui, sans-serif"
    font-weight="700"
    font-size="36"
    fill={accentFill}
  >M</text>

  {/* Estrellas + CLUB */}
  {showClubBand && (
    <g>
      <text
        x="34"
        y="83.5"
        text-anchor="middle"
        font-size="6.5"
        fill={accentFill}
        opacity="0.9"
      >★</text>
      <text
        x="51"
        y="82"
        text-anchor="middle"
        font-family="'JetBrains Mono', ui-monospace, monospace"
        font-weight="600"
        font-size="6"
        letter-spacing="2.5"
        fill={inkFill}
        opacity="0.95"
      >CLUB</text>
      <text
        x="66"
        y="83.5"
        text-anchor="middle"
        font-size="6.5"
        fill={accentFill}
        opacity="0.9"
      >★</text>
    </g>
  )}

  {/* EST · 2026 */}
  {showEst && (
    <text
      x="51"
      y="89"
      text-anchor="middle"
      font-family="'JetBrains Mono', ui-monospace, monospace"
      font-size="3.2"
      letter-spacing="1.2"
      fill={inkFill}
      opacity="0.55"
    >EST · 2026</text>
  )}
</svg>
