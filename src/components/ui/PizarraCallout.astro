---
import { Icon } from 'astro-icon/components';

interface Props {
  preset?: string;
  title?: string;
  description?: string;
  cta?: string;
}

const {
  preset,
  title = '¿Quieres verlo en movimiento?',
  description = 'Abre este ejercicio en la pizarra interactiva y muévelo paso a paso. Sin registro, gratis, en tu móvil.',
  cta = 'Visualizar en la pizarra',
} = Astro.props;

const href = preset ? `/pizarra/?preset=${preset}` : '/pizarra/';
---

<aside
  class="not-prose my-8"
  role="complementary"
  aria-label="Recurso interactivo: pizarra táctica"
>
  <a
    href={href}
    class="group relative block overflow-hidden rounded-xl p-5 transition-shadow hover:shadow-lg md:p-6"
    style="background: var(--color-marker); border: 2px solid var(--color-foreground); color: var(--color-foreground);"
  >
    <div class="flex items-start gap-4">
      <span
        class="grid h-12 w-12 flex-shrink-0 place-items-center rounded-lg md:h-14 md:w-14"
        style="background: var(--color-foreground); color: var(--color-marker);"
        aria-hidden="true"
      >
        <Icon name="lucide:clipboard-pen" class="h-6 w-6 md:h-7 md:w-7" />
      </span>

      <div class="flex-1 min-w-0">
        <p
          class="mono mb-1 text-xs font-bold uppercase"
          style="letter-spacing: 0.08em; opacity: 0.75;"
        >
          Pizarra Táctica · Gratis
        </p>
        <p
          class="display m-0 text-lg leading-tight md:text-xl"
          style="font-weight: 700;"
        >
          {title}
        </p>
        <p class="mt-2 text-sm leading-relaxed md:text-base" style="opacity: 0.85;">
          {description}
        </p>

        <div
          class="mt-3 inline-flex items-center gap-1.5 text-sm font-bold transition-transform group-hover:translate-x-1"
        >
          {cta}
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </div>
      </div>
    </div>
  </a>
</aside>
