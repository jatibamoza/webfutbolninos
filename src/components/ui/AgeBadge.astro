---
interface Props {
  min: number;
  max: number;
  variant?: 'default' | 'big';
}

const { min, max, variant = 'default' } = Astro.props;
---

{variant === 'big' ? (
  <div
    class="inline-flex items-baseline gap-1 rounded-md border border-[color:var(--color-border-strong)] bg-surface px-2.5 py-1.5"
    style="border-width: 1.5px;"
  >
    <span class="mono uppercase" style="font-size: 9px; letter-spacing: .12em; color: var(--color-foreground-subtle);">
      Edad
    </span>
    <span class="display" style="font-size: 18px; font-weight: 700;">{min}–{max}</span>
    <span class="mono" style="font-size: 10px; color: var(--color-foreground-muted);">años</span>
  </div>
) : (
  <span class="mono" style="font-size: 11px; color: var(--color-foreground-muted); letter-spacing: .04em;">
    {min}–{max} años
  </span>
)}
