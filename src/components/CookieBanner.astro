    --cc-btn-primary-hover-color: var(--color-background);

    --cc-btn-secondary-bg: var(--color-surface-alt);
    --cc-btn-secondary-color: var(--color-foreground);
    --cc-btn-secondary-hover-bg: color-mix(in oklab, var(--color-surface-alt), var(--color-foreground) 6%);
    --cc-btn-secondary-hover-color: var(--color-foreground);
    --cc-btn-secondary-border-color: var(--color-border-strong);
    --cc-btn-secondary-hover-border-color: var(--color-border-strong);

    --cc-separator-border-color: var(--color-border);
    --cc-cookie-category-block-bg: var(--color-paper);
    --cc-cookie-category-block-border: var(--color-border);
    --cc-cookie-category-block-bg-hover: var(--color-surface-alt);
    --cc-cookie-category-block-border-hover: var(--color-border-strong);
