  /* Caja del modal con borde de cuaderno + line-height más cómoda */
  #cc-main .cm,
  #cc-main .pm {
    border: 1px solid var(--color-border);
    line-height: 1.55;
  }

  /* Título con tipografía display (Fredoka) — coherencia con headings del sitio */
