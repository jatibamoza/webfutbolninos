---
import { breadcrumbJsonLd } from '@/lib/seo';
import { SITE_URL } from '@/consts';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const allItems = [{ label: 'Inicio', href: '/' }, ...items];

const jsonLdItems = allItems.map((item) => ({
  name: item.label,
  url: item.href ? new URL(item.href, SITE_URL).toString() : '',
}));
---

<nav aria-label="Migas de pan" class="py-3">
  <script
    type="application/ld+json"
    set:html={breadcrumbJsonLd(jsonLdItems)}
  />
  <ol class="flex flex-wrap items-center gap-1 text-sm text-foreground-muted">
    {
      allItems.map((item, index) => {
        const isLast = index === allItems.length - 1;
        return (
          <li class="flex items-center gap-1">
            {index > 0 && (
              <span class="select-none opacity-50" aria-hidden="true">›</span>
            )}
            {isLast || !item.href ? (
              <span class="font-semibold text-foreground" aria-current="page">
                {item.label}
              </span>
            ) : (
              <a
                href={item.href}
                class="transition-colors hover:text-primary focus-visible:rounded focus-visible:outline-2 focus-visible:outline-primary"
              >
                {item.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
