---
import { NAV_FOOTER, NAV_PRIMARY, SITE, SITE_URL } from '@/consts';
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="mx-auto max-w-7xl px-4 py-12 md:px-6">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">

      <!-- Col 1: Marca -->
      <div class="lg:col-span-1">
        <a
          href="/"
          class="mb-4 flex items-center gap-2 font-display text-lg font-bold text-primary"
        >
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">
            MG
          </span>
          {SITE.name}
        </a>
        <p class="text-sm leading-relaxed text-foreground-muted">
          {SITE.tagline}. Contenido para padres con hijos de 4 a 12 años.
        </p>
        <div class="mt-4 flex items-center gap-3">
          <a
            href={`https://twitter.com/${SITE.twitterHandle.replace('@', '')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-button text-foreground-muted transition-colors hover:bg-surface-alt hover:text-foreground"
            aria-label="Síguenos en Twitter/X"
          >
            <Icon name="lucide:twitter" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Col 2: Categorías -->
      <div>
        <p class="mb-4 text-sm font-bold uppercase tracking-wider text-foreground">
          Categorías
        </p>
        <ul class="space-y-2">
          {
            NAV_PRIMARY.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-foreground-muted transition-colors hover:text-primary"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: El sitio -->
      <div>
        <p class="mb-4 text-sm font-bold uppercase tracking-wider text-foreground">
          El sitio
        </p>
        <ul class="space-y-2">
          <li>
            <a href="/sobre/" class="text-sm text-foreground-muted transition-colors hover:text-primary">
              Sobre nosotros
            </a>
          </li>
          <li>
            <a href="/recursos/" class="text-sm text-foreground-muted transition-colors hover:text-primary">
              Recursos gratuitos
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="text-sm text-foreground-muted transition-colors hover:text-primary">
              Feed RSS
            </a>
          </li>
          <li>
            <a href="/contacto/" class="text-sm text-foreground-muted transition-colors hover:text-primary">
              Contacto
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Legal -->
      <div>
        <p class="mb-4 text-sm font-bold uppercase tracking-wider text-foreground">
          Legal
        </p>
        <ul class="space-y-2">
          {
            NAV_FOOTER.filter((item) =>
              ['/politica-privacidad/', '/politica-cookies/', '/aviso-legal/'].includes(item.href)
            ).map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-foreground-muted transition-colors hover:text-primary"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-xs text-foreground-muted">
          Este sitio participa en el programa de afiliados de Amazon EU. Como afiliado de Amazon, obtenemos ingresos por las compras adscritas que cumplen los requisitos aplicables.
        </p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 text-xs text-foreground-muted sm:flex-row">
      <p>© {year} {SITE.name} · {SITE_URL.replace('https://', '')}</p>
      <p>Hecho con cariño para padres futboleros</p>
    </div>
  </div>
</footer>
