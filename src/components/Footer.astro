---
import { NAV_FOOTER, NAV_PRIMARY, SITE, SITE_URL } from '@/consts';
import Logo from '@/components/ui/Logo.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations, type Locale } from '@/i18n';

const year = new Date().getFullYear();

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);

const navLabelKey: Record<string, 'nav-ejercicios' | 'nav-juegos' | 'nav-equipamiento' | 'nav-iniciacion' | 'nav-recursos'> = {
  '/ejercicios/': 'nav-ejercicios',
  '/juegos/': 'nav-juegos',
  '/equipamiento/': 'nav-equipamiento',
  '/iniciacion/': 'nav-iniciacion',
  '/recursos/': 'nav-recursos',
};

const legalLabelKey: Record<string, 'footer-privacy' | 'footer-cookies-policy' | 'footer-legal-notice'> = {
  '/politica-privacidad/': 'footer-privacy',
  '/politica-cookies/': 'footer-cookies-policy',
  '/aviso-legal/': 'footer-legal-notice',
};
---

<footer class="mt-20" style="background: var(--color-paper); border-top: 1px solid var(--color-border);">
  <!-- Línea de campo decorativa -->
  <div class="divider-pitch"></div>

  <div class="mx-auto max-w-7xl px-4 py-14 md:px-6">
    <div class="grid gap-12 md:grid-cols-3 lg:grid-cols-4">

      <!-- Col 1: Marca -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-3" aria-label={SITE.name}>
          <Logo size={48} />
          <span class="display text-lg" style="font-weight: 700; letter-spacing: -0.02em;">
            MiniGol <span style="color: var(--color-handwritten);">Club</span>
          </span>
        </a>
        <p class="mt-4 text-sm leading-relaxed" style="color: var(--color-foreground-muted);">
          {SITE.tagline}.
        </p>
        <p class="hand mt-4 text-2xl" style="color: var(--color-handwritten); transform: rotate(-1deg); display: inline-block;">
          {t('footer-handwritten')}
        </p>
      </div>

      <!-- Col 2: Categorías -->
      <div>
        <p
          class="mono mb-4 text-xs font-medium uppercase"
          style="letter-spacing: 0.12em; color: var(--color-foreground-subtle);"
        >
          {t('footer-sections')}
        </p>
        <ul class="space-y-3">
          {
            NAV_PRIMARY.map((item) => {
              const labelKey = navLabelKey[item.href as keyof typeof navLabelKey];
              const label = labelKey ? t(labelKey) : item.label;
              return (
                <li>
                  <a
                    href={item.href}
                    class="display text-base transition-colors hover:underline"
                    style="font-weight: 600; color: var(--color-foreground);"
                  >
                    {label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <!-- Col 3: El sitio -->
      <div>
        <p
          class="mono mb-4 text-xs font-medium uppercase"
          style="letter-spacing: 0.12em; color: var(--color-foreground-subtle);"
        >
          {t('footer-site')}
        </p>
        <ul class="space-y-3">
          <li>
            <a href="/sobre/" class="text-sm transition-colors hover:underline" style="color: var(--color-foreground-muted);">
              {t('footer-about')}
            </a>
          </li>
          <li>
            <a href="/recursos/" class="text-sm transition-colors hover:underline" style="color: var(--color-foreground-muted);">
              {t('footer-resources')}
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="text-sm transition-colors hover:underline" style="color: var(--color-foreground-muted);">
              {t('footer-rss')}
            </a>
          </li>
          <li>
            <a href="/contacto/" class="text-sm transition-colors hover:underline" style="color: var(--color-foreground-muted);">
              {t('footer-contact')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Legal -->
      <div>
        <p
          class="mono mb-4 text-xs font-medium uppercase"
          style="letter-spacing: 0.12em; color: var(--color-foreground-subtle);"
        >
          {t('footer-legal')}
        </p>
        <ul class="space-y-3">
          {
            NAV_FOOTER.filter((item) =>
              ['/politica-privacidad/', '/politica-cookies/', '/aviso-legal/'].includes(item.href)
            ).map((item) => {
              const labelKey = legalLabelKey[item.href as keyof typeof legalLabelKey];
              const label = labelKey ? t(labelKey) : item.label;
              return (
                <li>
                  <a
                    href={item.href}
                    class="text-sm transition-colors hover:underline"
                    style="color: var(--color-foreground-muted);"
                  >
                    {label}
                  </a>
                </li>
              );
            })
          }
          <li>
            <button
              type="button"
              data-cc="show-preferencesModal"
              class="text-sm transition-colors hover:underline"
              style="color: var(--color-foreground-muted); background: transparent; padding: 0; border: none; cursor: pointer;"
            >
              {t('footer-cookies-manage')}
            </button>
          </li>
        </ul>
      </div>
    </div>

    <!-- Sello de honestidad editorial + redes -->
    <div
      class="mt-12 flex flex-col gap-6 pt-8 sm:flex-row sm:items-center sm:justify-between"
      style="border-top: 1px solid var(--color-border);"
    >
      <div class="flex items-center gap-4">
        <span class="stamp">{t('footer-stamp')}</span>
        <a
          href={`https://twitter.com/${SITE.twitterHandle.replace('@', '')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-9 w-9 items-center justify-center rounded-md transition-colors"
          style="color: var(--color-foreground-muted);"
          aria-label={t('footer-twitter-aria')}
        >
          <Icon name="lucide:twitter" class="h-4 w-4" />
        </a>
      </div>
      <p class="mono text-xs" style="color: var(--color-foreground-subtle); letter-spacing: 0.04em;">
        © {year} {SITE.name} · {SITE_URL.replace('https://', '')}
      </p>
    </div>

    <p class="mt-8 text-xs leading-relaxed" style="color: var(--color-foreground-subtle); max-width: 60ch;">
      {t('footer-affiliate-disclosure')}
    </p>
  </div>
</footer>
