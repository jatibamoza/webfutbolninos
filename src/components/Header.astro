---
import { NAV_PRIMARY, SITE } from '@/consts';
import { Icon } from 'astro-icon/components';

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 h-16 border-b border-border bg-surface"
  x-data="{ open: false }"
>
  <div class="mx-auto flex h-full max-w-7xl items-center justify-between px-4 md:px-6">

    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2 font-display text-xl font-bold text-primary transition-opacity hover:opacity-80"
    >
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-white text-sm font-bold">
        MG
      </span>
      <span class="hidden sm:block">{SITE.name}</span>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex items-center gap-1">
        {
          NAV_PRIMARY.map((item) => {
            const isActive = currentPath.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'rounded-button px-3 py-2 text-sm font-semibold transition-colors',
                    isActive
                      ? 'text-primary'
                      : 'text-foreground-muted hover:bg-surface-alt hover:text-foreground',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Acciones -->
    <div class="flex items-center gap-2">
      <!-- Búsqueda -->
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-button text-foreground-muted transition-colors hover:bg-surface-alt hover:text-foreground"
        aria-label="Buscar"
        data-search-trigger
      >
        <Icon name="lucide:search" class="h-5 w-5" aria-hidden="true" />
      </button>

      <!-- Hamburger mobile -->
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-button text-foreground-muted transition-colors hover:bg-surface-alt hover:text-foreground lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="menu-toggle"
      >
        <Icon name="lucide:menu" class="h-5 w-5" aria-hidden="true" id="icon-open" />
        <Icon name="lucide:x" class="hidden h-5 w-5" aria-hidden="true" id="icon-close" />
      </button>
    </div>
  </div>

  <!-- Drawer mobile -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-surface lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
  >
    <nav class="mx-auto max-w-7xl px-4 py-4">
      <ul class="flex flex-col gap-1">
        {
          NAV_PRIMARY.map((item) => {
            const isActive = currentPath.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center rounded-button px-3 py-3 text-base font-semibold transition-colors',
                    isActive
                      ? 'text-primary hover:bg-surface-alt'
                      : 'text-foreground hover:bg-surface-alt',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
