---
import { NAV_PRIMARY, SITE } from '@/consts';
import { Icon } from 'astro-icon/components';
import Logo from '@/components/ui/Logo.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import LangSwitcher from '@/components/ui/LangSwitcher.astro';
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  hreflangs?: Array<{ lang: string; href: string }>;
}

const { hreflangs } = Astro.props;
const currentPath = Astro.url.pathname;

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);

const navLabelKey: Record<string, 'nav-ejercicios' | 'nav-juegos' | 'nav-equipamiento' | 'nav-iniciacion' | 'nav-mundial' | 'nav-recursos'> = {
  '/ejercicios/': 'nav-ejercicios',
  '/juegos/': 'nav-juegos',
  '/equipamiento/': 'nav-equipamiento',
  '/iniciacion/': 'nav-iniciacion',
  '/mundial-2026/': 'nav-mundial',
  '/recursos/': 'nav-recursos',
};
---

<header
  id="site-header"
  class="sticky top-0 z-50 transition-shadow"
  style="background: color-mix(in oklab, var(--color-background) 88%, transparent); backdrop-filter: saturate(180%) blur(8px); -webkit-backdrop-filter: saturate(180%) blur(8px); border-bottom: 1px solid var(--color-border);"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:px-6">

    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-3 transition-opacity hover:opacity-90"
      aria-label={`${SITE.name} — ${SITE.tagline}`}
    >
      <Logo size={36} class="-ml-0.5" />
      <span class="display hidden text-xl sm:block" style="font-weight: 700; letter-spacing: -0.02em;">
        MiniGol <span style="color: var(--color-handwritten);">Club</span>
      </span>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden lg:block" aria-label={t('nav-aria-primary')}>
      <ul class="flex items-center gap-1">
        {
          NAV_PRIMARY.map((item) => {
            const isActive = currentPath.startsWith(item.href);
            const isFeatured = 'featured' in item && item.featured === true;
            const labelKey = navLabelKey[item.href as keyof typeof navLabelKey];
            const label = labelKey ? t(labelKey) : item.label;
            // Punto a la derecha: amarillo si la página está activa, rojo si es
            // entrada destacada (Mundial). Activa gana sobre destacada para no duplicar.
            const dotColor = isActive
              ? 'var(--color-accent)'
              : isFeatured
                ? 'var(--color-energy)'
                : null;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'mono inline-flex items-center px-3 py-2 text-xs font-medium uppercase transition-colors',
                  ]}
                  style={`letter-spacing: 0.08em; color: ${isActive ? 'var(--color-foreground)' : 'var(--color-foreground-muted)'};`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {label}
                  {dotColor && (
                    <span
                      class="ml-2 inline-block h-1.5 w-1.5 rounded-full"
                      style={`background: ${dotColor};`}
                      aria-hidden="true"
                    ></span>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Acciones -->
    <div class="flex items-center gap-2">
      <LangSwitcher hreflangs={hreflangs} />
      <ThemeToggle />

      <a
        href="/buscar/"
        class="flex h-11 w-11 items-center justify-center rounded-md transition-colors"
        style="color: var(--color-foreground-muted);"
        aria-label={t('nav-aria-search')}
      >
        <Icon name="lucide:search" class="h-5 w-5" aria-hidden="true" />
      </a>

      <button
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-md transition-colors lg:hidden"
        style="color: var(--color-foreground-muted);"
        aria-label={t('nav-aria-open-menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="menu-toggle"
      >
        <Icon name="lucide:menu" class="h-5 w-5" aria-hidden="true" id="icon-open" />
        <Icon name="lucide:x" class="hidden h-5 w-5" aria-hidden="true" id="icon-close" />
      </button>
    </div>
  </div>

  <!-- Drawer mobile -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden"
    style="border-top: 1px solid var(--color-border); background: var(--color-paper);"
    role="dialog"
    aria-modal="true"
    aria-label={t('nav-aria-mobile-menu')}
  >
    <nav class="mx-auto max-w-7xl px-4 py-4">
      <ul class="flex flex-col gap-1">
        {
          NAV_PRIMARY.map((item) => {
            const isActive = currentPath.startsWith(item.href);
            const isFeatured = 'featured' in item && item.featured === true;
            const labelKey = navLabelKey[item.href as keyof typeof navLabelKey];
            const label = labelKey ? t(labelKey) : item.label;
            return (
              <li>
                <a
                  href={item.href}
                  class="flex items-center justify-between rounded-md px-3 py-3"
                  style={`color: ${isActive ? 'var(--color-foreground)' : 'var(--color-foreground-muted)'}; background: ${isActive ? 'var(--color-surface-alt)' : 'transparent'};`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span class="display text-base font-semibold inline-flex items-center gap-2">
                    {label}
                    {isFeatured && !isActive && (
                      <span
                        class="inline-block h-2 w-2 rounded-full"
                        style="background: var(--color-energy);"
                        aria-hidden="true"
                      ></span>
                    )}
                  </span>
                  <Icon name="lucide:chevron-right" class="h-4 w-4 opacity-50" aria-hidden="true" />
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile menu
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  // Header shadow on scroll
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) {
      header.style.boxShadow = '0 4px 12px rgba(26, 31, 44, 0.07)';
    } else {
      header.style.boxShadow = 'none';
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
