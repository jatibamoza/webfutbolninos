---
import { ADSENSE_CLIENT } from '@/consts';

interface Props {
  id: string;
  format?: 'horizontal' | 'rectangle' | 'in-article' | 'fluid';
  slot?: string;
  class?: string;
}

const { id, format = 'rectangle', slot, class: className = '' } = Astro.props;

// Min-height reservado por formato — evita CLS aunque AdSense tarde en cargar.
const reservedHeight: Record<NonNullable<Props['format']>, number> = {
  horizontal: 90,
  rectangle: 250,
  'in-article': 280,
  fluid: 200,
};

const adSenseEnabled = ADSENSE_CLIENT.length > 0 && slot !== undefined;
const minH = reservedHeight[format];
---

<aside
  data-ad-slot={id}
  aria-label="Publicidad"
  class:list={['mx-auto my-10 w-full max-w-3xl', className]}
>
  <div class="adslot-paper">
    <div class="adslot-inner" style={`min-height: ${minH}px;`}>
      {adSenseEnabled ? (
        <ins
          class="adsbygoogle block"
          style="display:block; width: 100%;"
          data-ad-client={ADSENSE_CLIENT}
          data-ad-slot={slot}
          data-ad-format={format === 'in-article' ? 'fluid' : 'auto'}
          data-full-width-responsive="true"
          {...(format === 'in-article' && { 'data-ad-layout': 'in-article' })}
        />
      ) : (
        <span>Espacio publicitario · {format}</span>
      )}
    </div>
  </div>
</aside>

{adSenseEnabled && (
  <Fragment>
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
    ></script>
    <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </Fragment>
)}
