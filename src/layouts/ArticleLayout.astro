---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import RelatedArticles from '@/components/RelatedArticles.astro';
import CatChip from '@/components/ui/CatChip.astro';
import Chrono from '@/components/ui/Chrono.astro';
import AgeBadge from '@/components/ui/AgeBadge.astro';
import { articleJsonLd } from '@/lib/seo';
import { SITE_URL, AUTHOR } from '@/consts';
import { categoryColorVar } from '@/lib/categories';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  article: CollectionEntry<'articulos'>;
  categoriaNombre: string;
  categoriaSlug: string;
  categoriaColor?: 'primary' | 'secondary' | 'accent' | 'fun' | 'energy' | 'info';
  relatedArticles?: CollectionEntry<'articulos'>[];
  headings?: MarkdownHeading[];
}

const {
  article,
  categoriaNombre,
  categoriaSlug,
  categoriaColor = 'secondary',
  relatedArticles = [],
  headings = [],
} = Astro.props;

const {
  title,
  description,
  cover,
  coverAlt,
  coverWidth,
  coverHeight,
  pubDate,
  updatedDate,
  tieneAfiliados,
  tiempoLectura,
  edadMin,
  edadMax,
  tags,
} = article.data;

const canonicalUrl = new URL(`/${article.id.replace(/\.mdx?$/, '')}/`, SITE_URL).toString();
const ogImageUrl = new URL(cover, SITE_URL).toString();
const colorVar = categoryColorVar(categoriaColor);

const jsonLd = articleJsonLd({
  title,
  description,
  url: canonicalUrl,
  image: ogImageUrl,
  pubDate,
  updatedDate,
  authorName: AUTHOR.name,
  authorUrl: AUTHOR.url,
  categoria: categoriaNombre,
});

const dateFormatted = pubDate.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length >= 2;

// Iniciales del autor para el avatar.
const authorInitials = AUTHOR.name
  .split(' ')
  .map((p) => p[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={cover}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <Header />

  <div class="mx-auto max-w-5xl px-4 md:px-6">
    <Breadcrumb
      items={[
        { label: categoriaNombre, href: `/${categoriaSlug}/` },
        { label: title },
      ]}
    />
  </div>

  <main id="main" class="mx-auto max-w-5xl px-4 pb-16 md:px-6">
    <div class:list={['gap-10', hasToc ? 'lg:grid lg:grid-cols-[1fr_240px]' : '']}>

      <!-- ============ Columna principal ============ -->
      <article class="min-w-0">
        <!-- Meta superior -->
        <header class="mb-6">
          <div class="mb-4 flex flex-wrap items-center gap-3">
            <a href={`/${categoriaSlug}/`}>
              <CatChip category={categoriaSlug} label={categoriaNombre} variant="bar" />
            </a>
            <span aria-hidden="true" style="width: 3px; height: 3px; border-radius: 50%; background: var(--color-border-strong);"></span>
            {tiempoLectura && <Chrono minutes={tiempoLectura} />}
            <span aria-hidden="true" style="width: 3px; height: 3px; border-radius: 50%; background: var(--color-border-strong);"></span>
            <time
              datetime={pubDate.toISOString()}
              class="mono"
              style="font-size: 11px; letter-spacing: 0.04em; color: var(--color-foreground-muted);"
            >
              {dateFormatted}
            </time>
          </div>

          <!-- H1 con dorsal de fondo -->
          <div class="relative mb-2">
            <span
              class="dorsal-fill pointer-events-none absolute select-none"
              style={`top: -28px; right: 0; font-size: clamp(80px, 14vw, 160px); color: ${colorVar}; opacity: 0.10; line-height: 0.85; z-index: 0;`}
              aria-hidden="true"
            >
              01
            </span>
            <h1
              class="display relative m-0"
              style="font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1; letter-spacing: -0.025em; z-index: 1;"
            >
              {title}
            </h1>
          </div>

          <p
            class="mt-4 text-base leading-relaxed md:text-lg"
            style="color: var(--color-foreground-muted); line-height: 1.55;"
          >
            {description}
          </p>

          <!-- Autor + edad -->
          <div
            class="mt-6 flex flex-wrap items-center gap-3 py-3"
            style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);"
          >
            <div class="flex items-center gap-2.5">
              <span
                class="grid h-9 w-9 place-items-center rounded-full text-xs font-bold"
                style={`background: ${colorVar}; color: var(--color-on-brand);`}
                aria-hidden="true"
              >
                {authorInitials}
              </span>
              <div style="line-height: 1.2;">
                <div style="font-weight: 700; font-size: 13px;">{AUTHOR.name}</div>
                <div class="mono" style="font-size: 10px; color: var(--color-foreground-subtle); letter-spacing: 0.06em;">
                  EDITOR · MINIGOL CLUB
                </div>
              </div>
            </div>
            <div class="flex-1"></div>
            <AgeBadge min={edadMin} max={edadMax} variant="big" />
            {updatedDate && (
              <span
                class="mono"
                style="font-size: 10px; letter-spacing: 0.08em; color: var(--color-foreground-subtle);"
              >
                ACTUALIZADO {updatedDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }).toUpperCase()}
              </span>
            )}
          </div>
        </header>

        <!-- Cover image con sello manuscrito -->
        <div class="relative mb-8" style="aspect-ratio: 16/9;">
          <img
            src={cover}
            alt={coverAlt}
            width={coverWidth}
            height={coverHeight}
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="h-full w-full overflow-hidden object-cover"
            style="border-radius: var(--radius-lg); border: 1px solid var(--color-border);"
          />
          <span
            class="hand absolute"
            style="bottom: -10px; right: 14px; font-size: 22px; color: var(--color-handwritten); background: var(--color-paper); padding: 4px 10px; border-radius: 6px; border: 1px solid var(--color-border); transform: rotate(-3deg);"
          >
            ¡plan de la sesión!
          </span>
        </div>

        <!-- Aviso afiliados -->
        {tieneAfiliados && (
          <aside
            class="mb-8 flex items-start gap-3 rounded-md p-3.5"
            style="border: 1px dashed var(--color-border-strong); background: var(--color-surface-alt);"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px;">
              <path d="M6 3h12v18l-6-4-6 4V3Z"></path>
            </svg>
            <p class="m-0 text-xs leading-relaxed" style="color: var(--color-foreground-muted);">
              Este artículo contiene enlaces afiliados de Amazon. Si compras algo, ganamos una pequeña
              comisión sin coste extra para ti. Solo recomendamos lo que usaríamos con nuestros peques.
            </p>
          </aside>
        )}

        <!-- TOC mobile -->
        {hasToc && (
          <details
            class="mb-8 lg:hidden"
            style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-paper);"
          >
            <summary class="flex cursor-pointer items-center justify-between px-4 py-3.5">
              <span class="flex items-center gap-2.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
                </svg>
                <span class="display" style="font-weight: 700; font-size: 14px;">Tabla de contenidos</span>
                <span class="mono" style="font-size: 10px; color: var(--color-foreground-subtle);">
                  {tocHeadings.length} secciones
                </span>
              </span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>
            <ol class="m-0 flex flex-col gap-1.5 pb-4 pt-2" style="padding-left: 36px; padding-right: 16px;">
              {tocHeadings.map((h, i) => (
                <li class:list={[h.depth === 3 ? 'pl-4' : '']} style="font-size: 14px;">
                  <a
                    href={`#${h.slug}`}
                    class="flex gap-2.5"
                    style="color: var(--color-foreground-muted);"
                  >
                    {h.depth === 2 && (
                      <span class="mono" style="font-size: 10px; color: var(--color-foreground-subtle); padding-top: 2px;">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                    )}
                    <span>{h.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )}

        <!-- MDX content -->
        <div class="prose max-w-none" id="article-content">
          <slot />
        </div>

        <!-- Tags + share -->
        {tags && tags.length > 0 && (
          <div
            class="mt-10 flex flex-wrap items-center justify-between gap-3 py-4"
            style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);"
          >
            <div class="flex flex-wrap gap-1.5">
              {tags.map((t: string) => (
                <span
                  style="padding: 6px 10px; background: var(--color-surface-alt); border-radius: 6px; font-size: 12px; font-weight: 600; color: var(--color-foreground);"
                >
                  #{t}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Bio del autor -->
        <aside
          class="mt-8 flex items-start gap-4 p-5"
          style="background: var(--color-paper); border: 1px solid var(--color-border); border-radius: var(--radius-lg);"
        >
          <span
            class="grid h-14 w-14 place-items-center rounded-full text-xl font-bold"
            style={`background: ${colorVar}; color: var(--color-on-brand); flex-shrink: 0;`}
            aria-hidden="true"
          >
            {authorInitials}
          </span>
          <div>
            <div class="display" style="font-size: 17px; font-weight: 700;">{AUTHOR.name}</div>
            <div
              class="mono mb-2"
              style="font-size: 11px; letter-spacing: 0.06em; color: var(--color-foreground-subtle);"
            >
              EDITOR · FUNDADOR · PADRE
            </div>
            <p class="m-0 text-sm leading-relaxed" style="color: var(--color-foreground-muted);">
              Padre de hijos en edad de fútbol base. No soy entrenador titulado: lo que escribo lo
              investigo, lo cruzo con fuentes primarias y, cuando el tema lo pide, lo reviso con un
              profesional. Más sobre cómo trabajamos en <a href="/sobre/" style="color: var(--color-primary); text-decoration: underline;">/sobre/</a>.
            </p>
          </div>
        </aside>

        {relatedArticles.length > 0 && (
          <RelatedArticles
            articles={relatedArticles}
            categoriaColor={categoriaColor}
            categoriaNombre={categoriaNombre}
          />
        )}
      </article>

      <!-- ============ TOC sidebar sticky desktop ============ -->
      {hasToc && (
        <aside class="hidden lg:block" aria-label="Tabla de contenidos">
          <div class="sticky top-24 pt-2">
            <div
              class="p-4"
              style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-paper);"
            >
              <div class="mb-3 flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
                </svg>
                <span
                  class="mono"
                  style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-foreground-subtle); text-transform: uppercase;"
                >
                  En este artículo
                </span>
              </div>
              <ol class="m-0 flex list-none flex-col gap-1 p-0" id="toc-list">
                {tocHeadings.map((h, i) => {
                  const isH3 = h.depth === 3;
                  return (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        data-toc-link={h.slug}
                        class:list={['flex gap-2.5 rounded-md px-2 py-1.5 transition-colors', isH3 ? 'pl-7' : '']}
                        style="font-size: 13px; line-height: 1.35; color: var(--color-foreground-muted); border-left: 2px solid transparent;"
                      >
                        {!isH3 && (
                          <span
                            class="mono flex-shrink-0"
                            style="font-size: 10px; color: var(--color-foreground-subtle); padding-top: 2px;"
                          >
                            {String(i + 1).padStart(2, '0')}
                          </span>
                        )}
                        <span>{h.text}</span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </div>
          </div>
        </aside>
      )}
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Scroll-spy del TOC con IntersectionObserver
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const headingEls = Array.from(links)
      .map((l) => document.getElementById(l.dataset.tocLink ?? ''))
      .filter(Boolean) as HTMLElement[];

    const setActive = (slug: string | null) => {
      for (const link of links) {
        const isActive = link.dataset.tocLink === slug;
        link.style.background = isActive ? 'var(--color-surface-alt)' : 'transparent';
        link.style.color = isActive ? 'var(--color-foreground)' : 'var(--color-foreground-muted)';
        link.style.borderLeftColor = isActive ? 'var(--color-foreground)' : 'transparent';
        link.style.fontWeight = isActive ? '700' : '500';
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
            return;
          }
        }
      },
      { rootMargin: '-15% 0px -70% 0px' }
    );

    headingEls.forEach((el) => observer.observe(el));
  }
</script>
