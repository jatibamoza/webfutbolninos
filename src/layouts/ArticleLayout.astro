---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import RelatedArticles from '@/components/RelatedArticles.astro';
import { articleJsonLd } from '@/lib/seo';
import { SITE_URL, AUTHOR } from '@/consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articulos'>;
  categoriaNombre: string;
  categoriaSlug: string;
  categoriaColor?: string;
  relatedArticles?: CollectionEntry<'articulos'>[];
}

const {
  article,
  categoriaNombre,
  categoriaSlug,
  categoriaColor = 'secondary',
  relatedArticles = [],
} = Astro.props;

const { title, description, cover, coverAlt, coverWidth, coverHeight, pubDate, updatedDate, keyword, tieneAfiliados } = article.data;

const canonicalUrl = new URL(`/articulos/${article.id}/`, SITE_URL).toString();
const ogImageUrl = new URL(cover, SITE_URL).toString();

const jsonLd = articleJsonLd({
  title,
  description,
  url: canonicalUrl,
  image: ogImageUrl,
  pubDate,
  updatedDate,
  authorName: AUTHOR.name,
  authorUrl: AUTHOR.url,
  categoria: categoriaNombre,
});

const dateFormatted = pubDate.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={cover}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <Header />

  <div class="mx-auto max-w-3xl px-4 md:px-6">
    <Breadcrumb
      items={[
        { label: categoriaNombre, href: `/${categoriaSlug}/` },
        { label: title },
      ]}
    />
  </div>

  <main id="main" class="mx-auto max-w-3xl px-4 pb-16 md:px-6">
    <!-- Article header -->
    <header class="mb-8">
      <!-- Badge categoría + meta -->
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <a
          href={`/${categoriaSlug}/`}
          class="rounded-sm bg-secondary/10 px-2 py-0.5 text-xs font-semibold text-secondary transition-colors hover:bg-secondary/20"
        >
          {categoriaNombre}
        </a>
        <span class="text-sm text-foreground-muted">
          {article.data.edadMin}–{article.data.edadMax} años
        </span>
        {article.data.tiempoLectura && (
          <span class="text-sm text-foreground-muted">
            · {article.data.tiempoLectura} min de lectura
          </span>
        )}
      </div>

      <h1 class="mb-4 font-display text-3xl font-bold leading-tight text-foreground md:text-4xl">
        {title}
      </h1>

      <p class="mb-6 text-lg leading-relaxed text-foreground-muted">
        {description}
      </p>

      <div class="flex items-center gap-2 text-sm text-foreground-muted">
        <span>Por <strong class="text-foreground">{AUTHOR.name}</strong></span>
        <span>·</span>
        <time datetime={pubDate.toISOString()}>{dateFormatted}</time>
        {updatedDate && (
          <>
            <span>·</span>
            <span>Actualizado <time datetime={updatedDate.toISOString()}>
              {updatedDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time></span>
          </>
        )}
      </div>
    </header>

    <!-- Cover image -->
    <div class="mb-8 overflow-hidden rounded-card" style="aspect-ratio: 16/9;">
      <img
        src={cover}
        alt={coverAlt}
        width={coverWidth}
        height={coverHeight}
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>

    {tieneAfiliados && (
      <div class="mb-8 rounded-card border border-border bg-surface-alt p-4 text-sm text-foreground-muted">
        <strong class="text-foreground">Aviso de afiliados:</strong> Este artículo contiene enlaces de Amazon Afiliados. Si realizas una compra a través de ellos, recibimos una pequeña comisión sin coste adicional para ti.
      </div>
    )}

    <!-- MDX content -->
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>

    <!-- Related articles -->
    {relatedArticles.length > 0 && (
      <RelatedArticles
        articles={relatedArticles}
        categoriaColor={categoriaColor}
        categoriaNombre={categoriaNombre}
      />
    )}
  </main>

  <Footer />
</BaseLayout>
