---
import '@/styles/global.css';
import fredokaWoff2 from '@fontsource-variable/fredoka/files/fredoka-latin-wght-normal.woff2?url';
import nunitoWoff2 from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import { SITE, SITE_URL, ADSENSE_CLIENT } from '@/consts';
import CookieBanner from '@/components/CookieBanner.astro';
import StickyNewsletter from '@/components/ui/StickyNewsletter.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  hreflangs?: Array<{ lang: string; href: string }>;
}

const {
  title,
  description = SITE.description,
  canonical,
  ogImage = SITE.defaultOgImage,
  ogType = 'website',
  noindex = false,
  hreflangs,
} = Astro.props;

const lang = Astro.currentLocale ?? 'es';
const ogLocale = lang === 'ca' ? 'ca_ES' : SITE.locale;
const skipLabel = lang === 'ca' ? 'Saltar al contingut' : 'Saltar al contenido';

const canonicalURL = canonical ?? new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageURL = new URL(ogImage, SITE_URL).toString();
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC theme bootstrap. Debe ejecutarse antes del primer paint:
         lee localStorage (`mg.theme`) y aplica `data-theme` al <html>.
         Si falta o vale 'auto', no añade atributo y el CSS sigue prefers-color-scheme. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('mg.theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          } else if (t === 'auto' || t === null) {
            document.documentElement.setAttribute('data-theme', 'auto');
          }
        } catch { /* localStorage no disponible: queda en auto */ }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {hreflangs && hreflangs.map((hl) => (
      <link rel="alternate" hreflang={hl.lang} href={hl.href} />
    ))}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preload" as="font" type="font/woff2" href={fredokaWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={nunitoWoff2} crossorigin />

    <!-- Preconnect a destinos terceros usados temprano para ahorrar handshake TLS. -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://region1.google-analytics.com" />
    {ADSENSE_CLIENT && <link rel="preconnect" href="https://pagead2.googlesyndication.com" />}

    <slot name="head" />

    <!-- Consent Mode v2: defaults denied. Los scripts gtag/js y adsbygoogle.js
         NO cargan hasta que el usuario acepte cookies via CookieBanner (RGPD +
         beneficio LCP). El inline aquí es lo único que se ejecuta eager. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-button focus:bg-foreground focus:px-4 focus:py-2 focus:text-background"
    >
      {skipLabel}
    </a>
    <slot />
    <CookieBanner />
    <StickyNewsletter />
  </body>
</html>
