---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { SITE_URL } from '@/consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  categoria: CollectionEntry<'categorias'>;
  articles: CollectionEntry<'articulos'>[];
  page?: {
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}

const { categoria, articles, page } = Astro.props;
const { nombre, slug, descripcion, descripcionCorta, color } = categoria.data;

const canonicalUrl = new URL(`/${slug}/`, SITE_URL).toString();

const colorHeroMap: Record<string, string> = {
  primary: 'bg-primary/8',
  secondary: 'bg-secondary/8',
  accent: 'bg-accent/8',
  fun: 'bg-fun/8',
  energy: 'bg-energy/8',
  info: 'bg-info/8',
};

const heroClass = colorHeroMap[color] ?? colorHeroMap.secondary;
---

<BaseLayout
  title={`${nombre} — MiniGol Club`}
  description={descripcionCorta}
  canonical={canonicalUrl}
>
  <Header />

  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <Breadcrumb items={[{ label: nombre }]} />
  </div>

  <!-- Category hero -->
  <div class:list={['py-10', heroClass]}>
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <p class="mb-1 text-sm font-semibold uppercase tracking-wider text-foreground-muted">
        Categoría
      </p>
      <h1 class="mb-3 font-display text-4xl font-bold text-foreground">
        {nombre}
      </h1>
      <p class="max-w-2xl text-lg text-foreground-muted">
        {descripcion}
      </p>
      <p class="mt-3 text-sm text-foreground-muted">
        {articles.length} artículo{articles.length !== 1 ? 's' : ''}
      </p>
    </div>
  </div>

  <main id="main" class="mx-auto max-w-7xl px-4 py-10 md:px-6">
    {articles.length === 0 ? (
      <div class="py-20 text-center">
        <p class="text-xl text-foreground-muted">
          Pronto publicaremos artículos en esta categoría.
        </p>
        <a href="/" class="mt-4 inline-block text-primary underline">
          Volver al inicio
        </a>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article, index) => (
          <ArticleCard
            article={article}
            categoriaColor={color}
            categoriaNombre={nombre}
            loading={index < 6 ? 'eager' : 'lazy'}
          />
        ))}
      </div>
    )}

    <!-- Paginación -->
    {page && page.lastPage > 1 && (
      <nav
        aria-label="Paginación"
        class="mt-12 flex items-center justify-center gap-4"
      >
        {page.url.prev ? (
          <a
            href={page.url.prev}
            class="rounded-button border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-surface-alt"
            rel="prev"
          >
            ← Anterior
          </a>
        ) : (
          <span class="rounded-button border border-border/50 bg-surface px-5 py-2.5 text-sm font-semibold text-foreground-muted/50 cursor-not-allowed">
            ← Anterior
          </span>
        )}

        <span class="text-sm text-foreground-muted">
          {page.currentPage} / {page.lastPage}
        </span>

        {page.url.next ? (
          <a
            href={page.url.next}
            class="rounded-button border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-surface-alt"
            rel="next"
          >
            Siguiente →
          </a>
        ) : (
          <span class="rounded-button border border-border/50 bg-surface px-5 py-2.5 text-sm font-semibold text-foreground-muted/50 cursor-not-allowed">
            Siguiente →
          </span>
        )}
      </nav>
    )}
  </main>

  <Footer />
</BaseLayout>
