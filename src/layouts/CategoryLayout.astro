---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import AdSlot from '@/components/AdSlot.astro';
import { SITE_URL } from '@/consts';
import { categoryColorVar } from '@/lib/categories';
import type { CollectionEntry } from 'astro:content';

interface Props {
  categoria: CollectionEntry<'categorias'>;
  articles: CollectionEntry<'articulos'>[];
  page?: {
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}

const { categoria, articles, page } = Astro.props;
const { nombre, slug, descripcion, color, orden } = categoria.data;

const canonicalUrl = new URL(`/${slug}/`, SITE_URL).toString();
const colorVar = categoryColorVar(color);
const dorsalNumber = String(orden).padStart(2, '0');

// Inserta un AdSlot in-feed cada 6 artículos (no al inicio).
const FEED_AD_EVERY = 6;
type GridItem =
  | { type: 'article'; article: CollectionEntry<'articulos'>; index: number }
  | { type: 'ad'; key: string };

const gridItems: GridItem[] = [];
articles.forEach((article, index) => {
  if (index > 0 && index % FEED_AD_EVERY === 0) {
    gridItems.push({ type: 'ad', key: `ad-${index}` });
  }
  gridItems.push({ type: 'article', article, index });
});
---

<BaseLayout
  title={`${nombre} — MiniGol Club`}
  description={descripcion}
  canonical={canonicalUrl}
>
  <Header />

  <div class="mx-auto max-w-7xl px-4 md:px-12">
    <Breadcrumb items={[{ label: nombre }]} />
  </div>

  <!-- ============ Category Hero con dorsal gigante ============ -->
  <section class="relative overflow-hidden" style="border-bottom: 2px solid var(--color-foreground);">
    <!-- Dorsal decorativo gigante -->
    <span
      class="dorsal-fill pointer-events-none absolute select-none"
      style={`top: -40px; right: -20px; font-size: clamp(220px, 32vw, 360px); color: ${colorVar}; opacity: 0.10; line-height: 0.85;`}
      aria-hidden="true"
    >
      {dorsalNumber}
    </span>

    <div class="relative mx-auto max-w-7xl px-4 py-10 md:px-12 md:py-16">
      <div class="flex items-center gap-3">
        <span class="cat-chip" style={`--cat-color: ${colorVar};`}>
          <span class="bar" aria-hidden="true"></span>
          <span>{nombre}</span>
        </span>
        <span class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-foreground-subtle);">
          SECCIÓN {dorsalNumber}
        </span>
      </div>

      <h1
        class="display mt-4 m-0"
        style="font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 0.95; letter-spacing: -0.025em;"
      >
        {nombre}
      </h1>

      <p
        class="mt-4 max-w-2xl text-base md:text-lg"
        style="color: var(--color-foreground-muted); line-height: 1.55;"
      >
        {descripcion}
      </p>

      <p class="mono mt-4" style="font-size: 11px; letter-spacing: 0.08em; color: var(--color-foreground-muted);">
        {articles.length} {articles.length === 1 ? 'ARTÍCULO PUBLICADO' : 'ARTÍCULOS PUBLICADOS'}
      </p>
    </div>
  </section>

  <main id="main" class="mx-auto max-w-7xl px-4 py-10 md:px-12 md:py-14">
    <h2 class="sr-only">Artículos de {nombre}</h2>

    {articles.length === 0 ? (
      <div class="card-paper py-16 text-center" style="padding: 4rem 2rem;">
        <span class="hand block" style="font-size: 28px; color: var(--color-handwritten);">
          aún no hay nada por aquí…
        </span>
        <p class="mt-3" style="color: var(--color-foreground-muted);">
          Pronto publicaremos artículos en esta categoría.
        </p>
        <a href="/" class="btn btn-ghost mt-6 inline-flex">Volver al inicio</a>
      </div>
    ) : (
      <div class="grid gap-4 md:gap-5" style="grid-template-columns: repeat(2, minmax(0,1fr));" data-cat-grid>
        {gridItems.map((item) =>
          item.type === 'article' ? (
            <ArticleCard
              article={item.article}
              categoriaColor={color}
              categoriaNombre={nombre}
              loading={item.index < 6 ? 'eager' : 'lazy'}
              hideCategoryChip
            />
          ) : (
            <div class="md:col-span-2 lg:col-span-3">
              <AdSlot id={`cat-feed-${slug}`} format="horizontal" />
            </div>
          ),
        )}
      </div>
    )}

    <!-- Paginación -->
    {page && page.lastPage > 1 && (
      <nav
        aria-label="Paginación"
        class="mt-12 flex items-center justify-center gap-4"
      >
        {page.url.prev ? (
          <a href={page.url.prev} class="btn btn-ghost" rel="prev">
            ← Anterior
          </a>
        ) : (
          <span
            class="btn btn-ghost cursor-not-allowed opacity-50"
            aria-disabled="true"
          >
            ← Anterior
          </span>
        )}

        <span
          class="mono"
          style="font-size: 12px; letter-spacing: 0.08em; color: var(--color-foreground-muted);"
        >
          {String(page.currentPage).padStart(2, '0')} / {String(page.lastPage).padStart(2, '0')}
        </span>

        {page.url.next ? (
          <a href={page.url.next} class="btn btn-ghost" rel="next">
            Siguiente →
          </a>
        ) : (
          <span
            class="btn btn-ghost cursor-not-allowed opacity-50"
            aria-disabled="true"
          >
            Siguiente →
          </span>
        )}
      </nav>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
  /* 3 cols en lg (Tailwind no aplica con grid-template-columns inline). */
  @media (min-width: 1024px) {
    [data-cat-grid] {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }
</style>
