---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import AdSlot from '@/components/AdSlot.astro';
import { Icon } from 'astro-icon/components';
import { SITE_URL } from '@/consts';
import { categoryColorVar } from '@/lib/categories';
import type { CollectionEntry } from 'astro:content';

interface Props {
  categoria: CollectionEntry<'categorias'>;
  articles: CollectionEntry<'articulos'>[];
  page?: {
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}

const { categoria, articles, page } = Astro.props;
const { nombre, slug, descripcion, descripcionCorta, color, orden, tagline } = categoria.data;

const canonicalUrl = new URL(`/${slug}/`, SITE_URL).toString();
const colorVar = categoryColorVar(color);
const dorsalNumber = String(orden).padStart(2, '0');

// Última actualización: la fecha de publicación más reciente del listado.
const sortedArticles = [...articles].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const lastDate = sortedArticles[0]?.data.pubDate;
const lastUpdated = lastDate
  ? lastDate
      .toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })
      .replace('.', '')
  : null;

// Filtros de edad: rangos canónicos del proyecto.
const ageRanges = [
  { id: 'todas', label: 'todas', min: 0, max: 99 },
  { id: '4-6', label: '4-6', min: 4, max: 6 },
  { id: '7-8', label: '7-8', min: 7, max: 8 },
  { id: '9-10', label: '9-10', min: 9, max: 10 },
  { id: '11-12', label: '11-12', min: 11, max: 12 },
];

// Niveles: filtro real sobre el campo `nivel` del frontmatter.
const levelChips = [
  { id: 'todas', label: 'todas' },
  { id: 'facil', label: 'fácil' },
  { id: 'media', label: 'media' },
  { id: 'reto', label: 'reto' },
];
---

<BaseLayout
  title={`${nombre} — MiniGol Club`}
  description={descripcionCorta}
  canonical={canonicalUrl}
>
  <Header />

  <div class="mx-auto max-w-7xl px-4 md:px-12">
    <Breadcrumb items={[{ label: nombre }]} />
  </div>

  <!-- ============ HERO ============ -->
  <section class="cat-hero" style={`--cat-color: ${colorVar};`}>
    <div class="cat-hero__inner mx-auto max-w-7xl px-4 md:px-12">
      <span class="cat-hero__dorsal" aria-hidden="true">{dorsalNumber}</span>

      <div class="cat-hero__content">
        <span class="cat-chip cat-hero__chip" style={`--cat-color: ${colorVar};`}>
          <span class="bar" aria-hidden="true"></span>
          <span>{nombre}</span>
        </span>

        <h1 class="cat-hero__title display">
          <span class="marker">{nombre}</span>{` de fútbol`}
        </h1>

        <p class="cat-hero__subtitle">{descripcion}</p>

        <p class="cat-hero__meta mono">
          <strong>{articles.length}</strong>&nbsp;{articles.length === 1 ? 'artículo' : 'artículos'}
          {lastUpdated && (
            <>
              <span class="cat-hero__sep" aria-hidden="true">·</span>
              actualizada el <strong>{lastUpdated}</strong>
            </>
          )}
          {tagline && (
            <>
              <span class="cat-hero__sep" aria-hidden="true">·</span>
              <span class="hand cat-hero__tagline">{tagline}</span>
            </>
          )}
        </p>
      </div>
    </div>
    <div class="divider-pitch"></div>
  </section>

  <!-- ============ FILTROS ============ -->
  <section class="cat-filters mx-auto max-w-7xl px-4 pt-6 md:px-12 md:pt-8">
    <div class="cat-filters__row">
      <span class="cat-filters__label mono">
        <Icon name="lucide:filter" class="h-3 w-3" />
        EDAD
      </span>
      <div class="cat-filters__chips" data-filter-edad>
        {ageRanges.map((r, i) => (
          <button
            type="button"
            class="cat-filters__chip"
            data-active={i === 0 ? 'true' : 'false'}
            data-edad-id={r.id}
            data-edad-min={r.min}
            data-edad-max={r.max}
          >
            {r.label}
          </button>
        ))}
      </div>
    </div>

    <div class="cat-filters__row">
      <span class="cat-filters__label mono">
        <Icon name="lucide:gauge" class="h-3 w-3" />
        NIVEL
      </span>
      <div class="cat-filters__chips" data-filter-nivel>
        {levelChips.map((l, i) => (
          <button
            type="button"
            class="cat-filters__chip"
            data-active={i === 0 ? 'true' : 'false'}
            data-nivel-id={l.id}
          >
            {l.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ AD CAT-TOP ============ -->
  <div class="mx-auto max-w-7xl px-4 md:px-12">
    <AdSlot id={`cat-top-${slug}`} format="horizontal" />
  </div>

  <!-- ============ GRID ============ -->
  <main id="main" class="mx-auto max-w-7xl px-4 pb-10 md:px-12 md:pb-14">
    <h2 class="sr-only">Artículos de {nombre}</h2>

    {articles.length === 0 ? (
      <div class="card-paper py-16 text-center" style="padding: 4rem 2rem;">
        <span class="hand block" style="font-size: 28px; color: var(--color-handwritten);">
          aún no hay nada por aquí…
        </span>
        <p class="mt-3" style="color: var(--color-foreground-muted);">
          Pronto publicaremos artículos en esta categoría.
        </p>
        <a href="/" class="btn btn-ghost mt-6 inline-flex">Volver al inicio</a>
      </div>
    ) : (
      <>
        <div
          class="grid gap-4 md:gap-5"
          style="grid-template-columns: repeat(2, minmax(0,1fr));"
          data-cat-grid
        >
          {sortedArticles.map((article, index) => (
            <ArticleCard
              article={article}
              categoriaColor={color}
              categoriaNombre={nombre}
              loading={index < 6 ? 'eager' : 'lazy'}
              hideCategoryChip
            />
          ))}
        </div>

        <p class="cat-empty hand" data-empty-state hidden>
          ningún artículo entra en ese rango de edad. prueba con otra opción.
        </p>
      </>
    )}

    {page && page.lastPage > 1 && (
      <nav
        aria-label="Paginación"
        class="mt-12 flex items-center justify-center gap-4"
      >
        {page.url.prev ? (
          <a href={page.url.prev} class="btn btn-ghost" rel="prev">← Anterior</a>
        ) : (
          <span class="btn btn-ghost cursor-not-allowed opacity-50" aria-disabled="true">← Anterior</span>
        )}

        <span class="mono" style="font-size: 12px; letter-spacing: 0.08em; color: var(--color-foreground-muted);">
          {String(page.currentPage).padStart(2, '0')} / {String(page.lastPage).padStart(2, '0')}
        </span>

        {page.url.next ? (
          <a href={page.url.next} class="btn btn-ghost" rel="next">Siguiente →</a>
        ) : (
          <span class="btn btn-ghost cursor-not-allowed opacity-50" aria-disabled="true">Siguiente →</span>
        )}
      </nav>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .cat-hero {
    position: relative;
    border-bottom: 2px solid var(--color-foreground);
    background:
      radial-gradient(circle at 0% 0%, color-mix(in oklab, var(--cat-color), transparent 92%) 0%, transparent 60%),
      var(--color-background);
    overflow: hidden;
  }
  .cat-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 12px;
    padding-top: 28px;
    padding-bottom: 28px;
  }
  .cat-hero__dorsal {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--cat-color);
    line-height: 0.85;
    font-size: clamp(96px, 24vw, 240px);
    letter-spacing: -0.04em;
    user-select: none;
    display: block;
  }
  .cat-hero__content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cat-hero__chip {
    align-self: flex-start;
  }
  .cat-hero__title {
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    line-height: 1;
    margin: 0;
    letter-spacing: -0.025em;
  }
  .cat-hero__subtitle {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 56ch;
  }
  .cat-hero__meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 8px;
    font-size: 12px;
    color: var(--color-foreground-muted);
    letter-spacing: 0.04em;
  }
  .cat-hero__meta strong {
    color: var(--color-foreground);
    font-weight: 700;
  }
  .cat-hero__sep {
    color: var(--color-foreground-subtle);
  }
  .cat-hero__tagline {
    font-size: 20px;
    line-height: 1;
    color: var(--color-handwritten);
    transform: rotate(-3deg);
    display: inline-block;
  }

  @media (min-width: 768px) {
    .cat-hero__inner {
      grid-template-columns: auto 1fr;
      gap: 28px;
      padding-top: 44px;
      padding-bottom: 44px;
    }
    .cat-hero__subtitle {
      font-size: 1.05rem;
    }
  }

  /* ---- Filtros ---- */
  .cat-filters__row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 14px;
    padding: 6px 0;
  }
  .cat-filters__row + .cat-filters__row {
    margin-top: 6px;
  }
  .cat-filters__label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--color-foreground-muted);
    flex-shrink: 0;
  }
  .cat-filters__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cat-filters__chip {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    padding: 10px 16px;
    min-height: 44px;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .cat-filters__chip:hover:not([disabled]) {
    background: var(--color-surface-alt);
  }
  .cat-filters__chip[data-active='true'] {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }
  /* ---- Grid breakpoint extra ---- */
  @media (min-width: 1024px) {
    [data-cat-grid] {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }

  /* ---- Empty filter ---- */
  .cat-empty {
    margin-top: 40px;
    text-align: center;
    color: var(--color-handwritten);
    font-size: 24px;
  }
</style>

<script is:inline>
  (() => {
    const grid = document.querySelector('[data-cat-grid]');
    const edadButtons = document.querySelectorAll('[data-filter-edad] button');
    const nivelButtons = document.querySelectorAll('[data-filter-nivel] button');
    const emptyState = document.querySelector('[data-empty-state]');
    if (!grid || edadButtons.length === 0) return;

    const state = { edadMin: 0, edadMax: 99, nivel: 'todas' };

    function applyFilter() {
      let visible = 0;
      grid.querySelectorAll('[data-article-card]').forEach((card) => {
        const aMin = parseInt(card.dataset.edadMin, 10);
        const aMax = parseInt(card.dataset.edadMax, 10);
        const cardNivel = card.dataset.nivel;
        const overlapsEdad = aMax >= state.edadMin && aMin <= state.edadMax;
        const matchesNivel = state.nivel === 'todas' || cardNivel === state.nivel;
        const show = overlapsEdad && matchesNivel;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (emptyState) emptyState.hidden = visible > 0;
    }

    edadButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        edadButtons.forEach((b) => (b.dataset.active = 'false'));
        btn.dataset.active = 'true';
        state.edadMin = parseInt(btn.dataset.edadMin, 10);
        state.edadMax = parseInt(btn.dataset.edadMax, 10);
        applyFilter();
      });
    });

    nivelButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        nivelButtons.forEach((b) => (b.dataset.active = 'false'));
        btn.dataset.active = 'true';
        state.nivel = btn.dataset.nivelId;
        applyFilter();
      });
    });
  })();
</script>
